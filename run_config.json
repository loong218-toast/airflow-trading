{
  "pair": "XXBTZUSD",
  "BASE_MINUTES": 5,
  "sl_tp_in_pct": true,
  "min_rr": 3.0,
  "sl_tp_interval_months": 3,

  "sl_range": {
    "min": 0.2,
    "max": 0.2,
    "step": 0.2
  },
  "tp_range": {
    "min": 5.0,
    "max": 5.0,
    "step": 0.5
  },

  "exit_windows_h": [4, 24],
  "trade_window_interval": [20],
  "limit_order_expiry_bars": [6, 12, 24],
  "use_limit_entry": true,

  "use_trailing_sl": [true],
  "trailing_sl_pct": [0.2, 0.3],
  "trailing_sl_interval": [3],
  "trailing_sl_stop_at_pos": [false],

  "signal_structure": {
    "ma": {
      "enabled": false,
      "combine": "all",
      "by_timeframe": {
        "5m": {
          "periods": [96],
          "types": ["ema", "kama"],
          "reversion": [false]
        },
        "1h": {
          "periods": [32],
          "types": ["ema", "sma"],
          "reversion": [false]
        }
      }
    },
    "stochastic": {
      "enabled": true,
      "combine": "all",
      "by_timeframe": {
        "5m": {
          "k": [12],
          "d": [8],
          "s": [4],
          "thresholds": [[30, 70]],
          "threshold_tolerance": 10
        },
        "15m": {
          "k": [12],
          "d": [8],
          "s": [4],
          "thresholds": [[30, 70]],
          "threshold_tolerance": 10
        }
      }
    },
    "lookback": {
      "enabled": true,
      "combine": "all",
      "by_timeframe": {
        "5m": {
          "entry_lookback_units": [0, 1, 2]
        },
        "15m": {
          "entry_lookback_units": [0, 1, 2]
        },
        "1h": {
          "entry_lookback_units": [0, 1, 2]
        }
      }
    },
    "bbw": {
      "enabled": false,
      "combine": "all",
      "by_timeframe": {
        "5m": {
          "periods": [48, 96, 128],
          "std": [2.5],
          "thresholds": [50]
        }
      }
    }
  },

  "BTC_SETTINGS": {
    "spread": 0.0002
  },
  "max_dd_threshold": 0.10,
  "MAX_EMPTY_ERA_STREAK": 80,
  "EQUITY_PARTITION_BY": "era_int",
  "risk_pct": 0.004,
  "trading_fees": 0.0004,
  "funding_period_hours": 8,
  "funding_rate_unit": "per_period",
  "force_rebuild_cache": false,
  "grid_start_date": "2022-09-01T00:00:00Z",
  "grid_end_date": "2025-09-15T23:59:59Z",

  "BATCH_SIZE": 150
}